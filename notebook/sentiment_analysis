ahai', 'waktu',\n","    'waktunya', 'walau', 'walaupun', 'ya', 'yaitu', 'yakin', 'yakni', 'yang', 'and', 'makan', 'bergizi',\n","    'gratis', 'makanbergizi', 'makanbergizigratis', 'nya'\n","]"]},{"cell_type":"markdown","metadata":{"id":"jBg_rS6ObzGj"},"source":["### **Preprocessing Function**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"6SzE_z8MbUEK"},"outputs":[],"source":["def preprocess_data(df, slang_dict, stopword_list, output_file_name='data_cleaned.csv'):\n","    df['content'] = df['content'].fillna('')\n","\n","    def preprocess_text_fixed(text):\n","        text = re.sub(r'http\\S+|www\\S+', '', text)\n","        text = re.sub(r'@\\w+', '', text)\n","        text = re.sub(r'[^a-zA-Z\\s]', '', text)\n","        text = text.lower()\n","\n","        pattern = r'\\b([a-z]{3,})\\s([a-z])\\b'\n","        text = re.sub(pattern, r'\\1\\2', text)\n","\n","        initial_tokens = text.split()\n","\n","        normalized_tokens = []\n","        for token in initial_tokens:\n","            if token in slang_dict:\n","                multi_word_tokens = slang_dict[token].split()\n","                normalized_tokens.extend(multi_word_tokens)\n","            else:\n","                normalized_tokens.append(token)\n","\n","        cleaned_tokens = []\n","        for token in normalized_tokens:\n","            if token not in stopword_list:\n","                cleaned_tokens.append(token)\n","\n","\n","        return ' '.join(cleaned_tokens), cleaned_tokens\n","\n","    df[['cleaned_content', 'tokenization']] = df['content'].apply(\n","        lambda x: pd.Series(preprocess_text_fixed(x))\n","    )\n","\n","    display(df)\n","\n","    df.to_csv(output_file_name, index=False)\n","    print(f\"\\nSuccessfully preprocessed data (fixed) and saved to {output_file_name}\")\n","\n","    return df"]},{"cell_type":"markdown","metadata":{"id":"sjbAECGtiIGk"},"source":["### **EDA After Preprocess**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"wDBijtisiK0X"},"outputs":[],"source":["def get_top_ngrams(corpus, n=None, top_k=20):\n","    vec = CountVectorizer(ngram_range=(n, n), stop_words='english').fit(corpus)\n","    bag_of_words = vec.transform(corpus)\n","    sum_words = bag_of_words.sum(axis=0)\n","    words_freq = [(word, sum_words[0, idx]) for word, idx in vec.vocabulary_.items()]\n","    words_freq = sorted(words_freq, key=lambda x: x[1], reverse=True)\n","    return words_freq[:top_k]\n","\n","def deep_text_eda(df, text_col='cleaned_content'):\n","    corpus = df[text_col].astype(str).tolist()\n","\n","    top_unigrams = get_top_ngrams(corpus, n=1, top_k=20)\n","    x, y = map(list, zip(*top_unigrams))\n","\n","    plt.figure(figsize=(12, 6))\n","    sns.barplot(x=y, y=x, palette='viridis')\n","    plt.title('Top 20 Unigrams (Single Words)')\n","    plt.show()\n","    print(\"\\n\")\n","\n","    top_bigrams = get_top_ngrams(corpus, n=2, top_k=20)\n","    x, y = map(list, zip(*top_bigrams))\n","\n","    plt.figure(figsize=(12, 6))\n","    sns.barplot(x=y, y=x, palette='magma')\n","    plt.title('Top 20 Bigrams (Word Pairs)')\n","    plt.show()\n","    print(\"\\n\")\n","\n","    all_text = ' '.join(corpus)\n","    wordcloud = WordCloud(width=800, height=400, background_color='white', colormap='plasma').generate(all_text)\n","\n","    plt.figure(figsize=(12, 6))\n","    plt.imshow(wordcloud, interpolation='bilinear')\n","    plt.axis('off')\n","    plt.title('Word Cloud of Raw Data')\n","    plt.show()"]},{"cell_type":"markdown","metadata":{"id":"YqroJmgCcKvG"},"source":["### **Handling Empty Data for Tokens**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"-a_lVeAScKFS"},"outputs":[],"source":["def remove_empty_tokens(df):\n","    empty_df = df[df['tokenization'].apply(lambda x: not isinstance(x, list) or len(x) == 0)]\n","    print(f\"Total empty/invalid documents: {len(empty_df)}\")\n","    display(empty_df)\n","\n","    df = df[df['tokenization'].apply(lambda x: isinstance(x, list) and len(x) > 0)].reset_index(drop=True)\n","    print(f\"\\nRemaining documents after handling empty: {len(df)}\\n\")\n","\n","    return df"]},{"cell_type":"markdown","metadata":{"id":"RLP3Qj_Fcf0A"},"source":["### **FE for LDA (Corpus/BoW)**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"KRwwegFEcPro"},"outputs":[],"source":["def fe_lda(df, exception=None):\n","    if exception is None:\n","        exception = {'makan', 'bergizi', 'gratis', 'makanbergizi', 'makanbergizigratis'}\n","\n","    data_words = [\n","        [token for token in tokens if token not in exception]\n","        for tokens in df['tokenization']\n","        if isinstance(tokens, list) and tokens\n","    ]\n","\n","    id2word = corpora.Dictionary(data_words)\n","    corpus = [id2word.doc2bow(text) for text in data_words]\n","\n","    print(f\"Data vectorized: {len(corpus)} documents, {len(id2word)} unique tokens.\")\n","\n","    return corpus, id2word, data_words"]},{"cell_type":"markdown","metadata":{"id":"mbWL3TGXc2yG"},"source":["### **LDA Model**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"29xhk_Ifcxo4"},"outputs":[],"source":["def find_optimal_lda(corpus, id2word, data_words, min_topics=3, max_topics=11):\n","    coherence_values = []\n","    model_list = []\n","\n","    for num_topics in range(min_topics, max_topics):\n","        model = gensim.models.LdaModel(corpus=corpus,\n","                                       id2word=id2word,\n","                                       num_topics=num_topics,\n","                                       random_state=42,\n","                                       passes=10,\n","                                       alpha='auto',\n","                                       per_word_topics=True)\n","        model_list.append(model)\n","        coherencemodel = CoherenceModel(model=model, texts=data_words, dictionary=id2word, coherence='c_v')\n","        coherence_values.append(coherencemodel.get_coherence())\n","\n","    plt.figure(figsize=(10, 5))\n","    plt.plot(range(min_topics, max_topics), coherence_values)\n","    plt.title(\"Coherence Score Plot\")\n","    plt.xlabel(\"Number of Topics\")\n","    plt.ylabel(\"Coherence Score (c_v)\")\n","    plt.xticks(range(min_topics, max_topics))\n","    plt.legend([\"coherence_values\"], loc='best')\n","    plt.show()\n","\n","    optimal_k_index = coherence_values.index(max(coherence_values))\n","    optimal_k = range(min_topics, max_topics)[optimal_k_index]\n","    print(f\"Optimal number of topics: {optimal_k}\")\n","\n","    return optimal_k, model_list, coherence_values"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"NmZWvuoSdIsg"},"outputs":[],"source":["def visualize_lda_model(model_list, optimal_k_index, corpus, id2word):\n","    final_lda_model = model_list[optimal_k_index]\n","    pprint(final_lda_model.print_topics())\n","\n","    pyLDAvis.enable_notebook()\n","    vis_data = gensimvis.prepare(final_lda_model, corpus, id2word, mds='tsne')\n","    display(vis_data)\n","\n","    return final_lda_model"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"zAfpeaYPdMEi"},"outputs":[],"source":["def plot_topic_wordclouds(final_lda_model):\n","    num_topics = final_lda_model.num_topics\n","\n","    ncols = 2\n","    nrows = (num_topics + 1) // ncols\n","\n","    fig, axes = plt.subplots(nrows=nrows, ncols=ncols, figsize=(15, nrows * 4))\n","\n","    if num_topics > 1:\n","        axes = axes.flatten()\n","    else:\n","        axes = [axes]\n","\n","    for i in range(num_topics):\n","        ax = axes[i]\n","        topic_words = dict(final_lda_model.show_topic(i, topn=30))\n","        wc = WordCloud(width=800, height=400, background_color='white', colormap='viridis').generate_from_frequencies(topic_words)\n","        ax.imshow(wc, interpolation='bilinear')\n","        ax.axis('off')\n","        ax.set_title(f\"Topic {i + 1}\", fontsize=14, pad=10)\n","\n","    for j in range(num_topics, len(axes)):\n","        fig.delaxes(axes[j])\n","\n","    plt.subplots_adjust(hspace=0.25, wspace=0.1)\n","    plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"VAmjvUPvdX8S"},"outputs":[],"source":["def assign_topics_and_save(df, final_lda_model, corpus, optimal_k, keywords_file, output_file):\n","    with open(keywords_file, 'w', encoding='utf-8') as f:\n","        for topic_id in range(optimal_k):\n","            topic_words = final_lda_model.show_topic(topic_id, topn=7)\n","            f.write(f\"Topik {topic_id}: {[word for word, prob in topic_words]}\\n\")\n","    print(f\"Topic keywords saved to '{keywords_file}'\")\n","\n","    def get_dominant_topic(doc_bow):\n","        try:\n","            topics = final_lda_model.get_document_topics(doc_bow, minimum_probability=0.0)\n","            dominant_topic = sorted(topics, key=lambda x: x[1], reverse=True)[0][0]\n","            return dominant_topic\n","        except:\n","            return -1\n","\n","    print(f\"Calculating topics for {len(corpus)} valid documents...\")\n","    dominant_topic_list = [get_dominant_topic(doc) for doc in corpus]\n","\n","    valid_doc_mask = (df['cleaned_content'].notna()) & (df['cleaned_content'].str.strip() != '')\n","\n","    df['topic_label'] = 'No Text'\n","    print(f\"Assigning {len(dominant_topic_list)} topics to {len(df.loc[valid_doc_mask])} valid rows...\")\n","    df.loc[valid_doc_mask, 'topic_label'] = dominant_topic_list\n","\n","    df.to_csv(output_file, index=False)\n","    print(f\"Data with topic labels saved to '{output_file}'\")\n","\n","    return df"]},{"cell_type":"markdown","metadata":{"id":"n2MusMhDdwoQ"},"source":["### **IndoBERT Sentiment**"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Pqthc4h_dwSU"},"outputs":[],"source":["def sentiment_analysis(input_file, output_file):\n","    df = pd.read_csv(input_file)\n","    df['content'] = df['content'].fillna('')\n","\n","    def clean_text_simple(text):\n","        text = str(text)\n","        text = re.sub(r'http\\S+|www\\S+', '', text)\n","        text = re.sub(r'@\\w+', '', text)\n","        text = re.sub(r'[^a-zA-Z0-9\\s]', ' ', text)\n","        text = re.sub(r'\\s+', ' ', text)\n","        return text.strip()\n","\n","    cleaned_texts = df['content'].apply(clean_text_simple).tolist()\n","\n","    if torch.cuda.is_available():\n","        device = 0\n","        print(\"GPU found! Running on GPU.\")\n","    else:\n","        device = -1\n","        print(\"No GPU found. Running on CPU.\")\n","\n","    print(\"Loading IndoBERT sentiment model...\")\n","\n","    model_name = \"mdhugol/indonesia-bert-sentiment-classification\"\n","    tokenizer = AutoTokenizer.from_pretrained(model_name, model_max_length=512)\n","    model = AutoModelForSequenceClassification.from_pretrained(model_name)\n","\n","    sentiment_pipeline = pipeline(\n","        \"sentiment-analysis\",\n","        model=model,\n","        tokenizer=tokenizer,\n","        device=device\n","    )\n","\n","    print(f\"Running sentiment analysis on {len(cleaned_texts)} documents...\")\n","\n","    results = sentiment_pipeline(\n","        cleaned_texts,\n","        batch_size=32,\n","        truncation=True,\n","        max_length=512\n","    )\n","\n","    label_mapping = {\n","        \"LABEL_0\": \"Positive\",\n","        \"LABEL_1\": \"Neutral\",\n","        \"LABEL_2\": \"Negative\"\n","    }\n","\n","    raw_labels = [r['label'] for r in results]\n","    df['sentiment_label'] = [label_mapping.get(label, label) for label in raw_labels]\n","    df['sentiment_score'] = [r['score'] for r in results]\n","\n","    if 'topic_label' in df.columns:\n","        df.loc[df['topic_label'] == 'No Text', 'sentiment_label'] = 'N/A'\n","\n","    df.loc[df['sentiment_label'] == 'N/A', 'sentiment_score'] = 0.0\n","\n","    print(\"\\nSentiment Label Distribution:\")\n","    print(df['sentiment_label'].value_counts(normalize=True))\n","\n","    df.to_csv(output_file, index=False)\n","    print(f\"\\nFinal combined data saved to '{output_file}'\")\n","\n","    return df"]},{"cell_type":"markdown","metadata":{"id":"94heNMIbeYVl"},"source":["### Evaluate Model"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"3hYB54tafLQQ"},"outputs":[],"source":["def lda_evaluation(final_lda_model, corpus, data_words, id2word, df):\n","    perplexity = final_lda_model.log_perplexity(corpus)\n","    print(f'Model Perplexity: {perplexity:.4f}')\n","\n","    coherence_model = CoherenceModel(model=final_lda_model, texts=data_words, dictionary=id2word, coherence='c_v')\n","    coherence_lda = coherence_model.get_coherence()\n","    print(f'Coherence Score: {coherence_lda:.4f}')\n","\n","    if 'topic_label' in df.columns:\n","        plt.figure(figsize=(12, 6))\n","        valid_data = df[df['topic_label'] != 'No Text'].copy()\n","\n","        try:\n","            valid_data['topic_label'] = valid_data['topic_label'].astype(int)\n","        except ValueError:\n","            pass\n","\n","        ax = sns.countplot(data=valid_data, x='topic_label', palette='viridis', hue='topic_label', legend=False)\n","\n","        plt.title('Number of Documents per Topic', fontsize=16)\n","        plt.xlabel('Topic ID', fontsize=12)\n","        plt.ylabel('Number of Documents', fontsize=12)\n","\n","        for p in ax.patches:\n","            height = p.get_height()\n","            if height > 0:\n","                ax.annotate(f'{int(height)}',\n","                            (p.get_x() + p.get_width() / 2., height),\n","                            ha='center', va='center',\n","                            xytext=(0, 10),\n","                            textcoords='offset points')\n","\n","        plt.tight_layout()\n","        plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Ria6BPRc1Dqv"},"outputs":[],"source":["def analyze_sentiment_distribution(input_file='data_final_combined.csv'):\n","    try:\n","        df_final = pd.read_csv(input_file)\n","    except FileNotFoundError:\n","        print(\"Error\")\n","        raise\n","    except Exception as e:\n","        print(f\"Error {e}\")\n","        raise\n","\n","    print(df_final['sentiment_score'].describe())\n","\n","    print(df_final.groupby('sentiment_label')['sentiment_score'].mean())\n","\n","    plt.figure(figsize=(10, 6))\n","    sns.histplot(data=df_final, x='sentiment_score', bins=30, kde=True)\n","\n","    mean_score = df_final['sentiment_score'].mean()\n","    plt.axvline(mean_score, color='red', linestyle='--',\n","                label=f\"AVG Score: {mean_score:.3f}\")\n","\n","    plt.title('IndoBERT Confidence Score Distribution', fontsize=16)\n","    plt.xlabel('Trust Score', fontsize=12)\n","    plt.ylabel('Amount of Data', fontsize=12)\n","    plt.legend()\n","    plt.show()\n","\n","    print(\"\\n\")\n","    plt.figure(figsize=(10, 6))\n","    sns.boxplot(\n","        data=df_final,\n","        x='sentiment_label',\n","        y='sentiment_score',\n","        order=['Positive', 'Neutral', 'Negative']\n","    )\n","    plt.title('Trust Score per Sentiment Category', fontsize=16)\n","    plt.xlabel('Sentiment', fontsize=12)\n","    plt.ylabel('Trust Score', fontsize=12)\n","    plt.show()\n","\n","    return df_final"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"tii2J2SMhD4M"},"outputs":[],"source":["def indobert_evaluation(df):\n","    sns.set_theme(style=\"whitegrid\", context=\"notebook\", font_scale=1.1)\n","\n","    sentiment_colors = {\n","        'Positive': '#2ecc71',\n","        'Neutral': '#95a5a6',\n","        'Negative': '#e74c3c'\n","    }\n","\n","    plt.figure(figsize=(10, 6))\n","    ax = sns.countplot(\n","        x='sentiment_label',\n","        data=df,\n","        palette=sentiment_colors,\n","        order=['Positive', 'Neutral', 'Negative'],\n","        edgecolor='black',\n","        linewidth=0.5\n","    )\n","\n","    sns.despine(left=True)\n","    plt.title('Total Sentiment Distribution', fontsize=18, pad=20, fontweight='bold')\n","    plt.xlabel('Sentiment Label', fontsize=14, labelpad=10)\n","    plt.ylabel('Count', fontsize=14, labelpad=10)\n","    plt.grid(axis='y', linestyle='--', alpha=0.7)\n","\n","    for p in ax.patches:\n","        ax.annotate(\n","            f'{int(p.get_height())}',\n","            (p.get_x() + p.get_width() / 2., p.get_height()),\n","            ha='center', va='bottom',\n","            xytext=(0, 5),\n","            textcoords='offset points',\n","            fontsize=12,\n","            fontweight='bold'\n","        )\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\n\")\n","\n","    valid_df = df[df['topic_label'] != 'No Text'].copy()\n","    try:\n","        valid_df['topic_label'] = valid_df['topic_label'].astype(int)\n","    except:\n","        pass\n","\n","    ct = pd.crosstab(valid_df['topic_label'], valid_df['sentiment_label'], normalize='index')\n","    cols = [c for c in ['Positive', 'Neutral', 'Negative'] if c in ct.columns]\n","    ct = ct[cols]\n","\n","    bar_colors = [sentiment_colors[col] for col in cols]\n","\n","    ax = ct.plot(\n","        kind='bar',\n","        stacked=True,\n","        figsize=(14, 7),\n","        color=bar_colors,\n","        edgecolor='white',\n","        width=0.75\n","    )\n","\n","    plt.title('Sentiment Proportion per Topic', fontsize=18, pad=20, fontweight='bold')\n","    plt.ylabel('Proportion', fontsize=14, labelpad=10)\n","    plt.xlabel('Topic ID', fontsize=14, labelpad=10)\n","    plt.legend(bbox_to_anchor=(1.01, 1), loc='upper left', frameon=False, fontsize=12)\n","    plt.grid(axis='y', linestyle='--', alpha=0.5)\n","    sns.despine()\n","\n","    for c in ax.containers:\n","        labels = [f'{v.get_height():.2f}' if v.get_height() > 0.05 else '' for v in c]\n","        ax.bar_label(c, labels=labels, label_type='center', color='white', fontsize=10, fontweight='bold')\n","\n","    plt.tight_layout()\n","    plt.show()\n","\n","    print(\"\\n\")\n","\n","    plt.figure(figsize=(12, 7))\n","    sns.violinplot(\n","        x='sentiment_label',\n","        y='sentiment_score',\n","        data=df,\n","        palette=sentiment_colors,\n","        order=['Positive', 'Neutral', 'Negative'],\n","        inner='quart',\n","        linewidth=1.5\n","    )\n","\n","    plt.title('Model Confidence Score Distribution', fontsize=18, pad=20, fontweight='bold')\n","    plt.xlabel('Sentiment Class', fontsize=14, labelpad=10)\n","    plt.ylabel('Confidence Score', fontsize=14, labelpad=10)\n","    plt.ylim(0.5, 1.02)\n","    sns.despine(trim=True)\n","\n","    plt.tight_layout()\n","    plt.show()"]},{"cell_type":"markdown","metadata":{"id":"uyRSBDWhaqJ1"},"source":["## **3. X DATA PROCESS**"]},{"cell_type":"markdown","metadata":{"id":"DLQAx8pubDvn"},"source":["### **Load Data**"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":424},"executionInfo":{"elapsed":494,"status":"ok","timestamp":1765122922289,"user":{"displayName":"RIZKI FATHONI","userId":"14888351379508314436"},"user_tz":-420},"id":"Jiyi8S7b2oiN","outputId":"6c8b3a61-b767-4a89-f39d-b85b13d79fdc"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["                 tweet_id          author                     datetime  \\\n","0     1970685333068238867     @ghozyulhaq   Sep 24, 2025 · 3:02 AM UTC   \n","1     1972974995459760451   @nabiylarisfa  Sep 30, 2025 · 10:41 AM UTC   \n","2     1972978414215930169     @zanatul_91  Sep 30, 2025 · 10:54 AM UTC   \n","3     1972659060324421900      @fardanayy   Sep 29, 2025 · 1:45 PM UTC   \n","4     1972868253941891422     @Dwynna_Win   Sep 30, 2025 · 3:37 AM UTC   \n","...                   ...             ...                          ...   \n","5199  1973316641930059946   @RiantiiMegaa    Oct 1, 2025 · 9:18 AM UTC   \n","5200  1973316698657923448       @AdhiPrYo    Oct 1, 2025 · 9:18 AM UTC   \n","5201  1973316786251768092    @DodhySamboh 
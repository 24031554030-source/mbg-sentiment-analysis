et.empty:\n","            continue\n","\n","        ct = pd.crosstab(subset['topic_name'], subset['sentiment_label'], normalize='index')\n","        cols = [c for c in ['Positive', 'Neutral', 'Negative'] if c in ct.columns]\n","        ct = ct[cols]\n","\n","        if 'Negative' in ct.columns:\n","            ct = ct.sort_values(by='Negative', ascending=False)\n","        else:\n","            ct = ct.sort_values(by=ct.columns[0], ascending=False)\n","\n","        order = ct.index\n","\n","        n_topics = len(order)\n","        dynamic_height = max(7, n_topics * 0.8 + 3)\n","\n","        bar_colors = [sentiment_colors[col] for col in cols]\n","\n","        ax = ct.plot(\n","            kind='barh',\n","            stacked=True,\n","            figsize=(12, dynamic_height),\n","            color=bar_colors,\n","            edgecolor='white',\n","            width=0.8\n","        )\n","\n","        plt.title(f'Sentiment Proportion per Topic on {platform}', fontsize=16, fontweight='bold')\n","        plt.xlabel('Proportion', fontsize=14)\n","        plt.ylabel('Topic Category', fontsize=14)\n","        plt.legend(bbox_to_anchor=(1.01, 1), loc='upper left', title='Sentiment')\n","\n","        for c in ax.containers:\n","            labels = [f'{v.get_width():.0%}' if v.get_width() > 0.05 else '' for v in c]\n","            ax.bar_label(c, labels=labels, label_type='center', color='white', fontsize=9, fontweight='bold')\n","\n","        plt.tight_layout()\n","        sns.despine()\n","        plt.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"_DsNu7Jt7J5P"},"outputs":[],"source":["def plot_sentiment_by_platform(df):\n","    sentiment_order = ['Positive', 'Neutral', 'Negative']\n","    sentiment_colors = {'Positive': 'forestgreen', 'Neutral': 'grey', 'Negative': 'firebrick'}\n","\n","    platform_sentiment = pd.crosstab(\n","        index=df['platform'],\n","        columns=df['sentiment_label'],\n","        normalize='index'\n","    ).mul(100)